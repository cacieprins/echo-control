[Unit]
Description=echo-control CLAP music indexer
# $HOME is shared with distrobox/toolbox containers, whose systemd would run this too.
ConditionVirtualization=!container
Requires=echo-control-qdrant.service
After=echo-control-qdrant.service

[Service]
Type=simple
ExecStart=@EXE@ daemon
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false

[Install]
WantedBy=default.target
