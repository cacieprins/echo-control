[Unit]
Description=Qdrant vector database for echo-control (docker)
# $HOME is shared with distrobox/toolbox containers, whose systemd would run this too.
ConditionVirtualization=!container

[Service]
Type=simple
ExecStartPre=-@DOCKER@ compose -f @COMPOSE@ pull --quiet
ExecStart=@DOCKER@ compose -f @COMPOSE@ up --remove-orphans
ExecStop=@DOCKER@ compose -f @COMPOSE@ down
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
